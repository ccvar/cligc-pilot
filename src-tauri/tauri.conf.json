{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cligc Pilot",
  "version": "0.1.0",
  "identifier": "com.cligc.pilot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Cligc Pilot",
        "width": 820,
        "height": 560,
        "minWidth": 820,
        "minHeight": 560,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "本地 AI 工作台：远程服务器、Cloudflare 建站与多模型对话",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ccvar/cligc-pilot/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQwOTFCM0I1RjBERDg0NUUKUldSZWhOM3d0Yk9SMEtXeG1ZRTFPdnAzUTVZcFFRUnU3cG5JaCs1NTlZK3lld0E0a3RMWUpIMGEK"
    }
  }
}
